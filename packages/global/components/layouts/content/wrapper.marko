import hierarchyAliases from "@mindful-web/marko-web/utils/hierarchy-aliases";
import { getAsArray, get } from "@mindful-web/object-path";
import buildGeoStructuredData from "@pmmi-media-group/package-global/utils/build-geo-structured-data";
import contentGeoMetadataFragment from "@pmmi-media-group/package-global/graphql/fragments/content-geo-metadata";

$ const { id, type, pageNode } = input;
$ const { contentMeterState, GAM } = out.global;
$ const sections = getAsArray(input, "sections");
$ const alias = get(input, "primarySection.alias");

<theme-content-page
  id=id
  type=type
  structured-data-query-fragment=contentGeoMetadataFragment
  build-structured-data=buildGeoStructuredData
>
  <@above-container>
    <marko-web-resolve-page|{ data: content }| node=pageNode>
      <if(contentMeterState && !contentMeterState.isLoggedIn)>
        <theme-content-meter-block
          content=content
          views=contentMeterState.views
          view-limit=contentMeterState.viewLimit
          display-overlay=contentMeterState.displayOverlay
          display-gate=contentMeterState.displayGate
        />
      </if>
    </marko-web-resolve-page>
  </@above-container>
  <@head>
    <marko-web-gtm-content-context|{ context }| id=id>
      <marko-web-gtm-push data=context />
    </marko-web-gtm-content-context>
    <marko-web-resolve-page|{ data: content }| node=pageNode>
      <marko-web-p1-events-track-content node=content />
      <marko-web-p1-events-track-social-share content=content />
      <global-gam-content-targeting obj=content />
      <if(get(content, "geoSummary"))>
        <meta name="geo:summary" content=get(content, "geoSummary") />
      </if>
    </marko-web-resolve-page>
  </@head>
  <@page>
    <marko-web-resolve-page|{ data: content }| node=pageNode>
      $ const aliases = hierarchyAliases(content.primarySection);
      $ const authors = getAsArray(content, "authors.edges").map((edge) => edge.node);
      <marko-web-page-wrapper>
        <for|s| of=sections>
          <@section|{ blockName }| modifiers=s.modifiers>
            <${s.renderBody}
              block-name=blockName
              content=content
              aliases=aliases
              authors=authors
            />
          </@section>
        </for>

        <@section>
          <theme-gam-define-display-ad
            name="rotation"
            position="content_page"
            aliases=aliases
            modifiers=["inter-block"]
          />
        </@section>
      </marko-web-page-wrapper>
    </marko-web-resolve-page>
  </@page>
</theme-content-page>
