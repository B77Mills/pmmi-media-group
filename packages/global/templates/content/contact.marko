import { get, getAsArray } from "@mindful-web/object-path";
import { buildImgixUrl } from "@mindful-web/image";
import queryFragment from "@mindful-web/marko-web-theme-monorail/graphql/fragments/section-feed-block";

$ const { id, type, pageNode } = data;

$ const { pagination: p, req, config } = out.global;
$ const perPage = 10;

<global-content-wrapper-layout
  id=id
  type=type
  page-node=pageNode
>
  <@section|{ aliases }| modifiers=["first-sm"]>
    <theme-gam-define-display-ad
      name="leaderboard"
      position="content_page"
      aliases=aliases
      modifiers=["inter-block"]
    />
  </@section>

  <@section|{ content }|>
    $ const { primaryImage } = content;
    $ const blockName = "contact-page";
    <marko-web-block name=blockName>
      <marko-web-content-name tag="h1" block-name=blockName obj=content />
      <marko-web-element block-name=blockName name="wrapper">
        <if(primaryImage && primaryImage.src)>
          $ const src = buildImgixUrl(primaryImage.src, {
            w: 160,
            h: 160,
            crop: "faces",
            fit: "crop",
          });
          $ const srcset = [`${buildImgixUrl(src, { dpr: 2 })} 2x`];
          <marko-web-img
            src=src
            srcset=srcset
            alt=primaryImage.alt
            class=`${blockName}__image`
          />
        </if>

        <theme-page-contents|{ blockName }| modifiers=["contact"]>
          <marko-web-content-website-deck
            block-name=blockName
            obj=content
          />
          <if(content.priorCompanies && content.priorCompanies.length)>
            <div style="padding-top: 8px">
              <b style="font-size: 20px"> Prior Companies:</b>
              <ul style="margin-left: -25px; margin-bottom: 0px">
              <for|priorCompany| of=content.priorCompanies.split(',')>
                <li>
                  <b class="section-feed-content-node__content-categories-listed-in">
                    ${priorCompany}
                  </b>
                </li>
              </for>
              </ul>
            </div>
          </if>
          <marko-web-content-city-state-zip block-name=blockName obj=content />
          $ const schedules = getAsArray(content, "websiteSchedules");
          $ const siteId = get(config, "websiteContext.id");
          $ const advisorNetworkSchedules = schedules.filter(
            (schedule) =>
              String(schedule.section.site.id) === siteId
              && schedule.section.alias.match("advisor-network")
              && schedule.section.alias !== "advisor-network").map((schedule) => schedule.section).map((category) => category.fullName.replace(/.+? \> .+? \>/, '').trim());
          <if(advisorNetworkSchedules.length)>
            <div style="margin-top: 5px">
              <b style="font-size: 20px">Core Capabilities:</b>
              <ul style="margin-left: -25px;">
                <for|schedule, scheduleIndex| of=advisorNetworkSchedules>
                  <li><b class="section-feed-content-node__content-categories-listed-in">${schedule}</b></li>
                </for>
              </ul>
            </div>
          </if>
          <marko-web-content-body block-name=blockName obj=content />
        </theme-page-contents>

      </marko-web-element>
    </marko-web-block>
  </@section>

  <@section>
    $ const queryParams = {
      contactId: id,
      limit: 10,
      skip: p.skip({ perPage }),
      queryFragment,
    };
    <marko-web-query|{ nodes }| name="all-author-content" params=queryParams>
      <marko-web-node-list
        inner-justified=true
        flush-x=true
        flush-y=false
        modifiers=["section-feed"]
      >
        <@nodes nodes=nodes>
          <@slot|{ node }|>
            <theme-section-feed-content-node node=node />
          </@slot>
        </@nodes>
      </marko-web-node-list>
    </marko-web-query>
    <theme-query-total-count|{ totalCount }| name="all-author-content" params={ contactId: id }>
      <theme-pagination-controls
        per-page=perPage
        total-count=totalCount
        path=req.path
      />
    </theme-query-total-count>
  </@section>
</global-content-wrapper-layout>
